# 强制统一行尾为 LF，避免 Windows 上 core.autocrlf 导致的无意义 diff
* text=auto eol=lf

# 常见二进制文件：禁止做换行归一化
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.gz binary
*.tgz binary
*.whl binary
*.exe binary
*.dll binary

# 频谱/数据文件
*.bin binary
*.npy binary
*.npz binary
*.h5 binary
*.hdf5 binary
